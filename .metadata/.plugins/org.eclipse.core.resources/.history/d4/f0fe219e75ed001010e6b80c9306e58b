/* USER CODE BEGIN 4 */
void HAL_FDCAN_RxFifo0Callback(FDCAN_HandleTypeDef *hfdcan, uint32_t RxFifo0ITs)
{
    // 1. Sprawdź, czy przerwanie dotyczy nowej wiadomości w FIFO0
    if ((RxFifo0ITs & FDCAN_IT_RX_FIFO0_NEW_MESSAGE) != 0)
    {
        FDCAN_RxHeaderTypeDef RxHeader;
        uint8_t RxData[8];

        // 2. Pobierz wiadomość
        if (HAL_FDCAN_GetRxMessage(hfdcan, FDCAN_RX_FIFO0, &RxHeader, RxData) == HAL_OK)
        {
            // --- LOGIKA DLA VESC ID = 3 ---

            // STATUS 4 (Temperatury)
            // Komenda 16 (0x10) przesunięta o 8 bitów + ID 3 -> 0x1003
            if (RxHeader.Identifier == 0x00001003)
            {
                // Bajt 0 i 1: Temp MOSFET
                int16_t temp_fet_raw = (int16_t)((RxData[0] << 8) | RxData[1]);
                VESC_MosfetTemp = (float)temp_fet_raw / 10.0f;

                // Bajt 2 i 3: Temp Silnika
                int16_t temp_motor_raw = (int16_t)((RxData[2] << 8) | RxData[3]);
                VESC_MotorTemp = (float)temp_motor_raw / 10.0f;
            }

            // STATUS 5 (Napięcie)
            // Komenda 27 (0x1B) przesunięta o 8 bitów + ID 3 -> 0x1B03
            else if (RxHeader.Identifier == 0x00001B03)
            {
                // Bajt 4 i 5: Napięcie wejściowe
                // (W Status 5 bajty 0-3 to Tacho, napięcie jest dalej)
                int16_t voltage_raw = (int16_t)((RxData[4] << 8) | RxData[5]);
                VESC_Voltage = (float)voltage_raw / 10.0f;
            }
        }
    }
}

