	        static uint32_t last_tick = 0;
	        uint32_t current_tick = HAL_GetTick();
	        if(last_tick == 0) last_tick = current_tick;
	        uint32_t dt_ms = current_tick - last_tick;
	        last_tick = current_tick;

	        // Zabezpieczenie przed dzieleniem przez zero
	        if (dt_ms == 0) dt_ms = 1;

	        if (rpm_filtered > 200)
	        {
	            // Automat biegów (Twój kod z poprzednich iteracji jest OK)
	            if (rpm_filtered > UPSHIFT_RPM) {
	                timer_upshift += dt_ms;
	                timer_downshift = 0;
	                if (timer_upshift > SHIFT_DELAY) {
	                    if (current_gear < MAX_GEAR) current_gear++;
	                    timer_upshift = 0;
	                }
	            }
	            else if (rpm_filtered < 3000) {
	               timer_upshift = 0; // Reset dopiero przy niskich obrotach
	               if (rpm_filtered < DOWNSHIFT_RPM) {
	                   timer_downshift += dt_ms;
	                   if (timer_downshift > SHIFT_DELAY) {
	                       if (current_gear > 1) current_gear--;
	                       timer_downshift = 0;
	                   }
	               }
	            }
	        } else {
	             current_gear = 1;
	             timer_upshift = 0;
	             timer_downshift = 0;
	        }

	        // ====================================================================
	        // 4. OBLICZANIE PRĄDÓW - MODEL FIZYCZNY (RÓŻNICZKA)
	        // ====================================================================

	        float target_drive = 0.0f;
	        float target_drag = 0.0f;

	        // A. Obliczenie Przyspieszenia (Różniczka RPM)
	        // accel = zmiana RPM w czasie tej pętli
	        float rpm_delta = (float)(rpm_filtered - prev_rpm);
	        // Jeśli chcesz przyspieszenie na sekundę: accel = rpm_delta / (dt_ms / 1000.0f);
	        // Ale dla uproszczenia strojenia użyjmy surowej delty (skoro pętla jest stała ~20ms)
	        float acceleration = rpm_delta;
	        prev_rpm = rpm_filtered; // Zapisz do następnego kroku

	        if (rpm_filtered > 200)
	        {
	            // --- NAPĘD (KOŁA) ---
	            // Prosta mapa + biegi
	            float drive_base = 2.0f; // Baza
	            // Soft start 200-1000
	            if (rpm_filtered < 1000) drive_base = (rpm_filtered - 200) / 800.0f * 2.0f;

	            target_drive = drive_base + ((current_gear - 1) * CURRENT_STEP);


	            // --- OPÓR (GENERATOR) - FIZYKA ---

	            // SKŁADNIK 1: INERCJA (To jest ta różniczka!)
	            // Jeśli przyspieszasz (acceleration > 0), opór rośnie drastycznie.
	            // Symuluje to rozpędzanie ciężkiego koła.
	            float inertia_current = 0.0f;
	            if (acceleration > 0) {
	                inertia_current = acceleration * INERTIA_GAIN;
	            }
	            // Uwaga: nie dodajemy inercji ujemnej (gdy zwalniasz), bo pedały by Ci "uciekły".

	            // SKŁADNIK 2: TARCIE/AERO (Zależy od prędkości)
	            // Im szybciej jedziesz, tym większy opór powietrza.
	            float friction_current = rpm_filtered * FRICTION_GAIN;

	            // SKŁADNIK 3: BIEG (Stałe obciążenie)
	            float gear_current = (current_gear - 1) * GEAR_RESISTANCE_STEP;

	            // SUMA OPORÓW
	            target_drag = inertia_current + friction_current + gear_current;

	            // Zabezpieczenie minimalne (żeby nie było 0A przy kręceniu)
	            if (target_drag < 1.0f && rpm_filtered > 500) target_drag = 1.0f;

	            // Kaganiec programowy (dla bezpieczeństwa przed zmianą w VESC Tool)
	            if (target_drag > 40.0f) target_drag = 40.0f;
	        }

	        // 5. FILTROWANIE WYJŚCIA I WYSYŁANIE
