        // Przy 5000 RPM -> 5000 * 0.001 = 5A oporu stałego.
        const float FRICTION_GAIN = 0.0015f;

        // 3. OPÓR BIEGU (Dodatek statyczny)
        const float GEAR_RESISTANCE_STEP = 0.5f;

