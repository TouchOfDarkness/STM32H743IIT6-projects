    }

    // 2. Start modułu FDCAN
    if (HAL_FDCAN_Start(&hfdcan1) != HAL_OK)
    {
      Error_Handler();
    }

    // 3. Włączenie przerwań (chcemy wiedzieć, kiedy przyjdzie nowa wiadomość)
    if (HAL_FDCAN_ActivateNotification(&hfdcan1, FDCAN_IT_RX_FIFO0_NEW_MESSAGE, 0) != HAL_OK)
    {
      Error_Handler();
    }
    uint8_t check;

    uint8_t Data;

    if (HAL_I2C_IsDeviceReady(&hi2c2, MPU6050_ADDR, 1, 100) == HAL_OK)

    {

    // 2. Wybudź MPU6050 z trybu Sleep Mode

    // Rejestr Power Management 1 (0x6B) ustawiamy na 0

    Data = 0;

    HAL_I2C_Mem_Write(&hi2c2, MPU6050_ADDR, 0x6B, 1, &Data, 1, 100);



    // Opcjonalnie: Konfiguracja akcelerometru (+/- 2g) i żyroskopu (+/- 250 dps)

    // Domyślnie są tak ustawione po reset, więc nie trzeba nic więcej pisać na start.
    }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
    // --- ZMIENNE AUTOMATYCZNEJ SKRZYNI BIEGÓW ---
        uint8_t current_gear = 1;           // Aktualny bieg (1 - domyślny)
        const uint8_t MAX_GEAR = 16;         // Ile mamy biegów?

        uint32_t timer_upshift = 0;         // Licznik czasu do zmiany w górę
        uint32_t timer_downshift = 0;       // Licznik czasu do zmiany w dół

        // Konfiguracja progów (zgodnie z Twoim opisem)
        const int32_t UPSHIFT_RPM = 7000;   // Powyżej tego liczymy czas do zmiany w górę
        const int32_t DOWNSHIFT_RPM = 5000; // Poniżej tego liczymy czas do redukcji (histereza)
        const uint32_t SHIFT_DELAY = 6000;  // 6 sekund (6000 ms)

        // Wartości przyrostowe
        const float CURRENT_STEP = 1.0f;    // O ile A zwiększamy napęd na każdym biegu
        const float DRAG_STEP = 0.2f;       // O ile A zwiększamy opór generatora (musi być dużo, żeby zwolnić nogi!)

        // Zmienne wykonawcze
        static float current_drive_filtered = 0.0f;
        static float current_drag_filtered = 0.0f;
        uint8_t Rec_Data[14];

  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  /* USER CODE BEGIN 3 */

	  HAL_I2C_Mem_Read(&hi2c2, MPU6050_ADDR, 0x3B, 1, rec_data, 14, 100);



	  // Łączenie bajtów (High << 8 | Low)

	  Accel_X_RAW = (int16_t)(rec_data[0] << 8 | rec_data[1]);

	  Accel_Y_RAW = (int16_t)(rec_data[2] << 8 | rec_data[3]);

	  Accel_Z_RAW = (int16_t)(rec_data[4] << 8 | rec_data[5]);

	  Temperature_RAW = (int16_t)(rec_data[6] << 8 | rec_data[7]);

	  Gyro_X_RAW = (int16_t)(rec_data[8] << 8 | rec_data[9]);

	  Gyro_Y_RAW = (int16_t)(rec_data[10] << 8 | rec_data[11]);

	  Gyro_Z_RAW = (int16_t)(rec_data[12] << 8 | rec_data[13]);



	  // Opcjonalnie: Konwersja na jednostki fizyczne (dla domyślnych ustawień)

	  // Akcelerometr: 16384 LSB = 1g

	  Ax = Accel_X_RAW / 16384.0;

	  Ay = Accel_Y_RAW / 16384.0;

	  Az = Accel_Z_RAW / 16384.0;



	  // Żyroskop: 131 LSB = 1 stopień/sek

	  Gx = Gyro_X_RAW / 131.0;

	  Gy = Gyro_Y_RAW / 131.0;

	  Gz = Gyro_Z_RAW / 131.0;



	  // Przykład prostej kalibracji (wpisz tu wartości, które widzisz, gdy płytka leży nieruchomo)

	  // Jeśli Gx w spoczynku pokazuje 0.45, wpisz tu - 0.45

	  Gx = Gx - 0.0;

	  Gy = Gy - 0.0;

	  Gz = Gz - 0.0;



	  // Sumowanie (Całkowanie): Kąt = Kąt + (Prędkość * Czas)

	  Angle_X = Angle_X + (Gx * dt);

	  Angle_Y = Angle_Y + (Gy * dt);

	  Angle_Z = Angle_Z + (Gz * dt);


	  // 2. ODCZYT OBROTÓW + FILTRACJA
	        int32_t rpm_raw = vescM.rpm;
	        if (rpm_raw < 0) rpm_raw = 0;

	        //filtr uśredniający nieregularne ERPM z generatora
	        int32_t rpm_filtered = Get_Filtered_RPM(rpm_raw);

	        // 3. LOGIKA AUTOMATYCZNEJ SKRZYNI BIEGÓW
	        // Czas pętli to ok. 25ms (Delay 20 + kod). Używamy HAL_GetTick() dla precyzji.
	        static uint32_t last_tick = 0;
	        uint32_t current_tick = HAL_GetTick();
	        uint32_t dt = current_tick - last_tick; // Czas od ostatniej pętli
	        last_tick = current_tick;

	        if (rpm_filtered > 200) // Tylko jak jedziemy
	        {
	            // --- Logika Zmiany w Górę ---
	            if (rpm_filtered > UPSHIFT_RPM) {
	                timer_upshift += dt;
	                timer_downshift = 0; // Reset licznika w dół

	                if (timer_upshift > SHIFT_DELAY) {
	                    // Minęło 6 sekund szybkiego pedałowania -> BIEG W GÓRĘ
	                    if (current_gear < MAX_GEAR) {
	                        current_gear++;
	                        // Opcjonalnie: Mignij diodą na płytce
	                    }
	                    timer_upshift = 0; // Reset licznika po zmianie
	                }
	            }
	            // --- Logika Zmiany w Dół ---
	            else if (rpm_filtered < DOWNSHIFT_RPM) {
	                timer_downshift += dt;
	                timer_upshift = 0; // Reset licznika w górę

	                if (timer_downshift > SHIFT_DELAY) {
	                    // Minęło 6 sekund wolnego pedałowania -> REDUKCJA
	                    if (current_gear > 1) {
	                        current_gear--;
	                    }
	                    timer_downshift = 0;
	                }
	            }
	            else {
	                // Jesteśmy w strefie "OK" (między 5000 a 7000) - zerujemy liczniki
	                timer_upshift = 0;
	                timer_downshift = 0;
	            }
	        } else {
	            // Zatrzymanie - reset do 1 biegu
	             current_gear = 1;
	             timer_upshift = 0;
	             timer_downshift = 0;
	        }

	        // 4. OBLICZANIE PRĄDÓW

	        float target_drive = 0.0f;
	        float target_drag = 0.0f;

	        if (rpm_filtered > 200)
	        {
	            // A. LOGIKA STARTU (LAUNCH) vs JAZDA (CRUISE)
	            if (rpm_filtered < 1000) {
	                // START: Dajemy 8A, żeby ruszyć z miejsca (jak prosiłeś)
	                // Robimy szybki ramp od 0 do 8A w zakresie 200-500 RPM
	                target_drive = 8.0f;
	                target_drag = 0.1f; // Minimalny opór przy starcie
	            }
	            else {
	                // JAZDA (CRUISE): 3A - 12A + BIEGI
	                // Bazowa mapa 3-12A dla zakresu 1000-9000 RPM
	                float progress = (float)(rpm_filtered - 1000) / (9000.0f - 1000.0f);
	                if (progress > 1.0f) progress = 1.0f;

	                float base_drive = 1.0f + (progress * (3.0f - 1.0f));
	                float base_drag = 2.0f + (progress * 6.0f); // Bazowy opór rośnie lekko

	                // DODAJEMY EFEKT BIEGÓW
	                // Bieg 1: Dodatek 0A
	                // Bieg 2: Dodatek 1.5A Drive, 5A Drag
	                // ...
	                float gear_drive_bonus = (current_gear - 1) * CURRENT_STEP; // np. 1.5A na bieg
	                float gear_drag_bonus = (current_gear - 1) * DRAG_STEP;     // np. 5.0A na bieg (Musi być dużo!)

	                target_drive = base_drive + gear_drive_bonus;
	                target_drag = base_drag + gear_drag_bonus;
	            }
	        }

	        // 5. FILTROWANIE WYJŚCIA (Ramping)
	        current_drive_filtered = (current_drive_filtered * 0.9f) + (target_drive * 0.1f);
	        current_drag_filtered = (current_drag_filtered * 0.9f) + (target_drag * 0.1f);

	        // 6. WYSYŁANIE DO VESC
	        VESC_SetCurrent(VESC_ID_L, current_drive_filtered);
	        HAL_Delay(1);
	        VESC_SetCurrent(VESC_ID_R, current_drive_filtered);
	        HAL_Delay(1);
	        VESC_SetBrakeCurrent(VESC_ID_M, current_drag_filtered);

	        HAL_Delay(20);
  }
  /* USER CODE END 3 */
}

